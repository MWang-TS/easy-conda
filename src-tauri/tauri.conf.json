{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Easy Conda",
  "version": "0.1.0",
  "identifier": "com.easyconda.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Easy Conda",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 620,
        "resizable": true
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "shortDescription": "Conda environment manager",
    "category": "DeveloperTool"
  }
}
